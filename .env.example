# Keystone — environment configuration (all values are OPTIONAL)
#
# A fresh clone runs without any .env file: the defaults below match the
# bundled docker-compose.yml. Copy this file to .env only if you want to
# change something. .env is git-ignored — never commit real secrets.

# --- Database -----------------------------------------------------------
# Postgres connection string. Default: the docker-compose Postgres service
# on localhost:5432 (user/password/db = keystone).
# DATABASE_URL="postgresql://keystone:keystone@localhost:5432/keystone?schema=public"

# --- Server port ----------------------------------------------------------
# Next.js defaults to 3000. The Settings "Fernzugriff" QR panel and the
# Tauri desktop shell's readiness check both read PORT — keep them in sync.
# PORT=3000

# --- Knowledge base import (scripts/import-knowledge-base.ts) -----------
# Default: the bundled content/knowledge-base/ and content/manifest.json.
# Relative paths are resolved from the repository root.
# KNOWLEDGE_BASE_PATH="content/knowledge-base"
# KNOWLEDGE_BASE_MANIFEST_PATH="content/manifest.json"

# --- Secrets at rest (lib/crypto.ts) -------------------------------------
# AES-256-GCM key used to encrypt provider API keys before they are stored
# in Postgres: a 64-character hex string (32 bytes). If unset, Keystone
# generates a random key on first use and keeps it in storage/encryption.key
# (git-ignored). Set your own with:
#   openssl rand -hex 32
# ENCRYPTION_KEY=""

# --- Optional LLM auto-detection (lib/llm/autodetect.ts) -----------------
# If set, the setup wizard can pre-configure the matching provider.
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# --- News feature (opt-in in Settings) ------------------------------------
# Cron expression for the background news fetch. Default: every 12 hours.
# NEWS_CRON_SCHEDULE="0 */12 * * *"
